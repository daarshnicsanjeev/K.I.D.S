# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/
build-artifacts/
build-artifacts-latest/
.gradle/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml

# Keystore files
*.jks
*.keystore

# Google Services (API keys & credentials)
google-services.json

# OS specific files
.DS_Store
Thumbs.db

# Graphify temporary extraction caches (keep graphify-out/ exports)
graphify-out/.graphify_*
